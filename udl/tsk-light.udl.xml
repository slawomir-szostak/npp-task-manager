<?xml version="1.0" encoding="UTF-8" ?>
<NotepadPlus>
    <UserLang name="TSK Tasks (Light)" ext="tsk" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="yes" allowFoldOfComments="no" foldCompact="no" forcePureLC="1" decimalSeparator="0" />
            <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
        </Settings>
        <KeywordLists>
            <!-- 00 = line comment open (day header), 03/04 = block comment open/close (// remark) -->
            <Keywords name="Comments">00== 01 02 03// 04((EOL))</Keywords>
            <Keywords name="Numbers, prefix1"></Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, extras1"></Keywords>
            <Keywords name="Numbers, extras2"></Keywords>
            <Keywords name="Numbers, suffix1"></Keywords>
            <Keywords name="Numbers, suffix2"></Keywords>
            <Keywords name="Numbers, range"></Keywords>
            <Keywords name="Operators1"></Keywords>
            <Keywords name="Operators2"></Keywords>
            <Keywords name="Folders in code1, open"></Keywords>
            <Keywords name="Folders in code1, middle"></Keywords>
            <Keywords name="Folders in code1, close"></Keywords>
            <Keywords name="Folders in code2, open"></Keywords>
            <Keywords name="Folders in code2, middle"></Keywords>
            <Keywords name="Folders in code2, close"></Keywords>
            <Keywords name="Folders in comment, open"></Keywords>
            <Keywords name="Folders in comment, middle"></Keywords>
            <Keywords name="Folders in comment, close"></Keywords>
            <!-- Your own tags / people / projects. Plain words, space separated. -->
            <Keywords name="Keywords1"></Keywords>
            <Keywords name="Keywords2"></Keywords>
            <Keywords name="Keywords3"></Keywords>
            <Keywords name="Keywords4"></Keywords>
            <Keywords name="Keywords5"></Keywords>
            <Keywords name="Keywords6"></Keywords>
            <Keywords name="Keywords7"></Keywords>
            <Keywords name="Keywords8"></Keywords>
            <!-- Delimiter N = open(3N-3) escape(3N-2) close(3N-1). All close at end of line. -->
            <Keywords name="Delimiters">00!! 01 02((EOL)) 03~~ 04 05((EOL)) 06?? 07 08((EOL)) 09## 10 11((EOL)) 12** 13 14((EOL)) 15&gt;&gt; 16 17((EOL)) 18++ 19 20((EOL)) 21-- 22 23((EOL))</Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <!-- // remark -->
            <WordsStyle name="COMMENTS" fgColor="767676" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" nesting="0" />
            <!-- == YYYY-MM-DD day header -->
            <WordsStyle name="LINE COMMENTS" fgColor="1F3864" bgColor="DCE6F1" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <!-- task number on an unmarked line -->
            <WordsStyle name="NUMBERS" fgColor="8A8A8A" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS1" fgColor="1F6FB2" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS2" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS3" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS4" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS5" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS6" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS7" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORDS8" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="OPERATORS" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="FOLDER IN CODE1" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="FOLDER IN CODE2" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="FOLDER IN COMMENT" fgColor="1A1A1A" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <!-- !! important / urgent -->
            <WordsStyle name="DELIMITERS1" fgColor="C00000" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <!-- ~~ in progress -->
            <WordsStyle name="DELIMITERS2" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <!-- ?? waiting for someone -->
            <WordsStyle name="DELIMITERS3" fgColor="0072A8" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <!-- ## on hold -->
            <WordsStyle name="DELIMITERS4" fgColor="C25E00" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <!-- ** idea / maybe -->
            <WordsStyle name="DELIMITERS5" fgColor="8A2BE2" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <!-- >> migrated / backlog -->
            <WordsStyle name="DELIMITERS6" fgColor="6E7B8B" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" nesting="0" />
            <!-- ++ done -->
            <WordsStyle name="DELIMITERS7" fgColor="008A00" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" nesting="0" />
            <!-- (minus minus) won't do / cancelled -->
            <WordsStyle name="DELIMITERS8" fgColor="B4B4B4" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" nesting="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
